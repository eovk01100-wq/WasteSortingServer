# 이 파일을 복사해서 .env 를 만들고 빈 칸을 채운다.
# .env 는 Git에 올라가지 않는다. 이 예시 파일에는 진짜 값을 절대 적지 않는다.

# --- DB (MySQL) ---
DB_NAME=wastesorting
DB_USER=wastesorting
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_HOST=localhost
DB_PORT=3307

# --- Gemini (1-3단계에서 사용) ---
GEMINI_API_KEY=

# --- 사용량 제한 (1-5단계, 비워 두면 기본값) ---
RATE_PER_TOKEN_PER_MINUTE=20
RATE_PER_IP_PER_MINUTE=60
RATE_DEVICE_ISSUE_PER_IP_PER_HOUR=10
RATE_DAILY_AI_CAP=500

# --- 로그인 (2-3단계) ---
# JWT 서명 키. 32자 이상 무작위 값. 만드는 방법은 README 또는 안내 참고
JWT_SECRET=
